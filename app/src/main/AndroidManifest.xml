<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <provider android:authorities="com.asterion.nexus.library" />
        <provider android:authorities="com.asterion.nexus.terabox.documents" />
        <provider android:authorities="com.openlocal.office.terabox.documents" />
        <provider android:authorities="com.ailm.android.asterionart.sheets" />
        <package android:name="com.asterion.control" />
    </queries>
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AsterionArt"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".studio.StudioActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
            </intent-filter>
        </activity>
        <service
            android:name=".runtime.CreationService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />
        <provider
            android:name="com.asterion.bridge.AsterionControlBridgeProvider"
            android:authorities="${applicationId}.asterion.bridge"
            android:exported="true"
            android:grantUriPermissions="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.outputs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/output_paths" />
        </provider>
    </application>
</manifest>
